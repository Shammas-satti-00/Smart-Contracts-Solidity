					"contents": "{\n\n    function array_storeLengthForEncoding_t_string_memory_ptr_fromStack(pos, length) -> updated_pos {\n        mstore(pos, length)\n        updated_pos := add(pos, 0x20)\n    }\n\n    function store_literal_in_memory_4f4d6283454b528bce61a908a772808c61dd40185e3ba77c713fa86ebb8d7362(memPtr) {\n\n        mstore(add(memPtr, 0), \"You need to spend more ETH!\")\n\n    }\n\n    function abi_encode_t_stringliteral_4f4d6283454b528bce61a908a772808c61dd40185e3ba77c713fa86ebb8d7362_to_t_string_memory_ptr_fromStack(pos) -> end {\n        pos := array_storeLengthForEncoding_t_string_memory_ptr_fromStack(pos, 27)\n        store_literal_in_memory_4f4d6283454b528bce61a908a772808c61dd40185e3ba77c713fa86ebb8d7362(pos)\n        end := add(pos, 32)\n    }\n\n    function abi_encode_tuple_t_stringliteral_4f4d6283454b528bce61a908a772808c61dd40185e3ba77c713fa86ebb8d7362__to_t_string_memory_ptr__fromStack_reversed(headStart ) -> tail {\n        tail := add(headStart, 32)\n\n        mstore(add(headStart, 0), sub(tail, headStart))\n        tail := abi_encode_t_stringliteral_4f4d6283454b528bce61a908a772808c61dd40185e3ba77c713fa86ebb8d7362_to_t_string_memory_ptr_fromStack( tail)\n\n    }\n\n}\n",
